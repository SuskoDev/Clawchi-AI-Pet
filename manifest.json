{
  "manifest_version": 3,
  "name": "Clawchi - AI Agent Pet",
  "version": "0.1.0",
  "description": "A pixel-art crab companion that shows what your AI agent is doing — idling, thinking, working, or waiting for input.",
  "permissions": ["storage", "sidePanel"],
  "optional_permissions": ["tabs", "notifications", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "externally_connectable": {
    "matches": ["*://*/*"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sprites/*.json",
        "sprites/accessories/*.json",
        "relay-test.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
